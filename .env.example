# ========================================================
# GenomeAI — Environment Configuration Template
# ========================================================

# --------------------------------------------------------
# 1. Frontend & Next.js Service
# --------------------------------------------------------
# Database Connection String for SQLite user authentication
DATABASE_URL="file:./dev.db"

# Cryptographic Session & JWT Signing Secret (Minimum 32 characters)
# Generate using: openssl rand -base64 32
AUTH_SECRET="genome_ai_secret_key_session_auth_phase2_super_secure_32b_token"

# Frontend Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend FastAPI Service URL (Client & Server Proxy)
BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Cookie Security (set to 'true' in HTTPS production environments)
SECURE_COOKIES="false"

# --------------------------------------------------------
# 2. Python Backend & PySpark Service
# --------------------------------------------------------
# Backend API Port and Host
HOST="0.0.0.0"
PORT="8000"

# Allowed CORS Origins (comma-separated or list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Maximum Upload File Size in Bytes (50MB default)
MAX_UPLOAD_SIZE_BYTES=52428800

# Apache Spark Cluster Settings
SPARK_APP_NAME="GenomeAI-Spark-AnomalyDetection"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY="2g"
